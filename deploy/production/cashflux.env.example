CASHFLUX_SERVER_ADDR=127.0.0.1:8105
CASHFLUX_SERVER_DATA_DIR=/var/lib/cashflux
CASHFLUX_SERVER_AUTH_MODE=token
CASHFLUX_SERVER_REGISTRATION_OPEN=false
CASHFLUX_SERVER_BILLING=false
CASHFLUX_SERVER_APP_ORIGIN=https://budget.earlcameron.com
CASHFLUX_SERVER_APP_DIR=/opt/CashFlux/bin/web
CASHFLUX_SERVER_CONSOLE_DIR=/opt/CashFlux/bin/web/admin
CASHFLUX_SERVER_PORTAL_DIR=/opt/CashFlux/bin/web/portal
CASHFLUX_SERVER_MASTER_KEY=replace-with-exactly-32-random-bytes
CASHFLUX_SERVER_SESSION_KEY=replace-with-a-separate-random-signing-secret
CASHFLUX_SERVER_TOKEN_SHA256=replace-with-the-break-glass-token-sha256
CASHFLUX_SERVER_TRUSTED_PROXIES=127.0.0.1/32,::1/128
CASHFLUX_SERVER_HTTP_MAX_IN_FLIGHT=256
CASHFLUX_SERVER_HTTP_RATE_LIMIT_PER_MINUTE=600
CASHFLUX_SERVER_HTTP_USER_RATE_LIMIT_PER_MINUTE=300
CASHFLUX_SERVER_AUTH_RATE_LIMIT_PER_MINUTE=20
CASHFLUX_SERVER_GRPC_READ_LIMIT_BYTES=16777216
CASHFLUX_SERVER_GRPC_MAX_ACTIVE_CONNECTIONS=128
CASHFLUX_SERVER_GRPC_MAX_CONNECTIONS_PER_CLIENT=8
CASHFLUX_SERVER_GRPC_MAX_UPGRADES_PER_CLIENT_PER_MINUTE=60
CASHFLUX_SERVER_GRPC_MAX_STREAMS_PER_USER=8
CASHFLUX_SERVER_GRPC_KEEPALIVE_INTERVAL=30s
CASHFLUX_SERVER_GRPC_IDLE_TIMEOUT=90s
CASHFLUX_SERVER_BLOB_MAX_BYTES=33554432
CASHFLUX_SERVER_BLOB_IO_TIMEOUT=10s
CASHFLUX_SERVER_AUDIT_RETENTION_DAYS=365
CASHFLUX_SERVER_SNAPSHOT_HISTORY_RETENTION_DAYS=180
CASHFLUX_SERVER_BACKUP_RETENTION_DAYS=30
CASHFLUX_SERVER_LOG_FORMAT=json
CASHFLUX_SERVER_LOG_LEVEL=info
CASHFLUX_SERVER_LOG_HOT_PATH_SAMPLE_RATE=100
