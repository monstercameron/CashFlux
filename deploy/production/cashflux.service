[Unit]
Description=CashFlux same-origin budgeting server
Documentation=https://github.com/monstercameron/CashFlux
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=cashflux
Group=cashflux
WorkingDirectory=/opt/CashFlux
EnvironmentFile=/etc/cashflux/cashflux.env
ExecStartPre=/opt/CashFlux/bin/cashflux-server migrate-check
ExecStart=/opt/CashFlux/bin/cashflux-server
Restart=always
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=30s

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
RemoveIPC=yes
ReadWritePaths=/var/lib/cashflux
StateDirectory=cashflux
StateDirectoryMode=0700
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
LimitNOFILE=4096
TasksMax=256
MemoryMax=768M

[Install]
WantedBy=multi-user.target
